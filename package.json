{
  "name": "docmesh-kbms-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:bff\" \"npm:dev:frontend\"",
    "dev:bff": "node --watch server/index.js",
    "dev:frontend": "vite",
    "build": "vite build",
    "start": "node server/index.js",
    "test": "npm run test:connection && npm run test:unit && npm run test:integration",
    "test:connection": "NODE_ENV=test vitest run tests/connection",
    "test:unit": "NODE_ENV=test vitest run tests/unit",
    "test:integration": "NODE_ENV=test vitest run tests/integration",
    "test:real": "NODE_ENV=test RUN_REAL_INTEGRATION=1 vitest run tests/real",
    "test:all": "npm run test:connection && npm run test:unit && npm run test:integration && npm run test:real"
  },
  "dependencies": {
    "express": "^5.1.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^9.2.1",
    "jsdom": "^26.1.0",
    "supertest": "^7.1.4",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
